static func count() -> int:
	return TYPES.size()

static func name(type_id: int) -> String:
	return TYPES[type_id][0]

static func flags(type_id: int) -> int:
	return TYPES[type_id][1]

static func draw_mask(type_id: int) -> int:
	return TYPES[type_id][2]

static func marker_icon(type_id: int) -> int:
	return TYPES[type_id][3]

static func handler_id(type_id: int) -> int:
	return TYPES[type_id][4]

static func draw_id(type_id: int) -> int:
	return TYPES[type_id][5]

static func find(type_name: String) -> int:
	## 0x43a360-style lookup by exact name; -1 when missing.
	for i in TYPES.size():
		if TYPES[i][0] == type_name:
			return i
	return -1
